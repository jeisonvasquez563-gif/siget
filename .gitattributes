# Los archivos que se ejecutan o se leen en Linux (las VMs) deben conservar finales de línea LF aunque se clonen en Windows:
# un script con CRLF falla con «bad interpreter» y una unidad de systemd con CRLF no se carga.
*.sh              text eol=lf
*.container       text eol=lf
*.pod             text eol=lf
*.volume          text eol=lf
*.conf            text eol=lf
*.service         text eol=lf
*.timer           text eol=lf
*.sql             text eol=lf
