[Unit]
Description=nginx de SIGET (TLS 1.3, única puerta de entrada) en el pod siget
After=siget-backend.service

[Container]
Image=registry.access.redhat.com/ubi9/nginx-126:1-1777855212
ContainerName=siget-nginx
Pod=siget.pod
Volume=/home/siget/config/nginx.conf:/etc/nginx/nginx.conf:ro,Z
# Certificado y clave TLS como podman secret; la clave solo la lee el usuario de nginx (uid 1001)
Secret=siget-nginx-crt,mode=0444
Secret=siget-nginx-key,uid=1001,gid=0,mode=0400
Exec=nginx -g "daemon off;"
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp
Tmpfs=/var/log/nginx

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
