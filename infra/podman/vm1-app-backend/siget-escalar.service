# SIGET: escalamiento automático de trámites vencidos (PT-3). Lo dispara siget-escalar.timer cada hora.
# Unidad de usuario de `siget` en VM1: ~/.config/systemd/user/siget-escalar.service
# Contenedor desechable con la imagen del backend y SOLO dos secretos: la contraseña de escalador_role y la CA.
# Ese rol solo puede ejecutar siget.escalar_vencidos(): no lee ni escribe ninguna tabla.
[Unit]
Description=SIGET: escalar los trámites que superaron su plazo
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/podman run --rm --name siget-escalar \
  --secret siget-db-escalador-password,mode=0444 --secret siget-ca,mode=0444 \
  -e DJANGO_SETTINGS_MODULE=config.settings_escalador \
  -e SIGET_DB_ESCALADOR_PASSWORD_FILE=/run/secrets/siget-db-escalador-password \
  -e SIGET_DB_SSLROOTCERT=/run/secrets/siget-ca \
  -e SIGET_CACHE_DIR=/tmp/siget-cache-escalar \
  --read-only --tmpfs /tmp --cap-drop=ALL --security-opt=no-new-privileges \
  localhost/siget-backend:dev python manage.py escalar_vencidos
